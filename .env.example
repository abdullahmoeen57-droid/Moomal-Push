# Copy to .env. Replace placeholders before starting the backend.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
ACCESS_TOKEN_MINUTES=60
COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ENABLE_API_DOCS=true
# If omitted, local SQLite backend/moomal_college.db is used.
# For production PostgreSQL, set this explicitly (no silent fallback):
# DATABASE_URL=postgresql+psycopg2://db_user:strong_password@localhost:5432/moomal_nursing_db
